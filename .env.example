# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/botx

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Platform Selection (JSON array)
# Options: ["twitter"], ["bluesky"], or ["twitter", "bluesky"]
ENABLED_PLATFORMS=["twitter"]

# Twitter/X API Credentials
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_BOT_ID=your_bot_user_id

# Bluesky API Credentials
# Get app password from: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=yourbot.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_SERVICE_URL=https://bsky.social

# Application Settings
EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.8
